---
/**
 * @fileoverview Renders social media feed using the common SectionLayout.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import "../styles/card.css";
import { siteConfig } from "../data/config";
import { getYearsString } from "../utils/dateUtils.ts";

const { social } = siteConfig.sections;
---

<SectionLayout id={social.id} icon="share" title="Social Feed">
  <div class="social-feed grid-4">
    {
      social.items.map((post) => {
        const expString = getYearsString(post.startDate);

        // Replaced <article> with <social-tracker> to ensure the custom element actually hooks onto the DOM.
        return (
          <social-tracker class="social-card card" data-start={post.startDate}>
            <header class="card-header">
              <div class="avatar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
              </div>
              <div class="user-info">
                <div class="name-row">
                  <strong>{post.author}</strong>
                </div>
                <span class="headline">{post.headline}</span>
                <span class="created-at">{expString}</span>
              </div>
              <a href={post.linkUrl} aria-label="View external link" target="_blank" rel="noopener noreferrer">
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
              </a>
            </header>

            <div class="card-body">
              <p>{post.content}</p>
              <div class="img-wrapper">
                <img src={post.imageUrl} alt="Post media graphic" loading="lazy" />
              </div>
            </div>

            <footer class="card-footer">
              <div class="tags">
                {post.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </footer>
          </social-tracker>
        );
      })
    }
  </div>
</SectionLayout>

<script>
  import { getYearsString } from "../utils/dateUtils.ts";

  /**
   * Custom element to hydrate dynamic timestamps.
   */
  class SocialTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      if (start) {
        this.querySelector(".created-at")!.textContent = getYearsString(start);
      }
    }
  }

  customElements.define("social-tracker", SocialTracker);
</script>

<style>
  /* Ensure Web Component acts as a block-level container */
  social-tracker {
    display: block;
  }

  .social-feed {
    margin-bottom: var(--spacing-lg);
  }

  .card-header {
    display: flex;
    padding: var(--spacing-md);
    gap: 12px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    background: var(--theme-surface-variant);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--theme-on-surface-variant);
  }

  .avatar svg {
    width: 28px;
    height: 28px;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
  }

  .name-row {
    display: flex;
    justify-content: space-between;
    color: var(--theme-on-surface);
    font-family: var(--font-headline);
  }

  .headline,
  .created-at {
    font-size: 12px;
    color: var(--theme-on-surface-variant);
  }

  .card-body p {
    margin: 0;
    padding: 0 var(--spacing-md) var(--spacing-md) var(--spacing-md);
    font-size: 14px;
    line-height: 1.5;
    color: var(--theme-on-surface);
  }

  .card-body img {
    width: 100%;
    display: block;
    border-top: 1px solid var(--theme-outline-variant);
  }

  .card-footer {
    padding: 12px var(--spacing-md);
    border-top: 1px solid var(--theme-outline-variant);
    background: var(--theme-surface-container);
  }
</style>
