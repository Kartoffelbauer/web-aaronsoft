---
/**

 * @fileoverview A unified Factory Component for rendering domain-specific cards.
 * Implements a TypeScript Discriminated Union to guarantee strict type safety
 * based on the `type` parameter, eliminating prop-drilling errors.
 */

import "../../styles/card.css";
import { getYearsString } from "../../utils/dateUtils.ts";

// 1. Define exact shapes for our supported data payloads
interface ProjectPayload {
  title: string;
  description: string;
  imageUrl: string;
  link: string;
  tags: string[];
}

interface SocialPayload {
  author: string;
  headline: string;
  startDate: string;
  linkUrl: string;
  content: string;
  imageUrl: string;
  tags: string[];
}

// 2. The Discriminated Union (Factory Best Practice)
// Binds the 'type' string directly to the required 'payload' structure.
type Props =
  | { type: "project"; payload: ProjectPayload }
  | { type: "social"; payload: SocialPayload };

const { type, payload } = Astro.props;
---

{/* FACTORY ROUTER: Render the specific DOM structure based on the requested type */}
{
  type === "project" ? (
    <article class="card project-card">
      <div class="img-wrapper">
        <img
          src={payload.imageUrl}
          alt={`Preview graphic for ${payload.title}`}
          loading="lazy"
        />
      </div>

      <div class="project-content">
        <header class="project-header">
          <h3>{payload.title}</h3>
          <a
            href={payload.link}
            aria-label={`View external link for ${payload.title}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined" aria-hidden="true">
              open_in_new
            </span>
          </a>
        </header>

        <p class="project-desc">{payload.description}</p>

        <footer class="tags">
          {payload.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </footer>
      </div>
    </article>
  ) : (
    <social-tracker class="card social-card" data-start={payload.startDate}>
      <header class="card-header">
        <div class="avatar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
        </div>
        <div class="user-info">
          <div class="name-row">
            <strong>{payload.author}</strong>
          </div>
          <span class="headline">{payload.headline}</span>
          {/* Server-side initial render */}
          <span class="created-at">{getYearsString(payload.startDate)}</span>
        </div>
        <a href={payload.linkUrl} aria-label="View external link" target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
        </a>
      </header>

      <div class="card-body">
        <p>{payload.content}</p>
        <div class="img-wrapper">
          <img src={payload.imageUrl} alt="Post media graphic" loading="lazy" />
        </div>
      </div>

      <footer class="card-footer">
        <div class="tags">
          {payload.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </footer>
    </social-tracker>
  )
}

<script>
  import { getYearsString } from "../../utils/dateUtils.ts";

  /**
   * Client-side hydration for dynamic timestamps.
   * Astro bundles this once per page, regardless of how many cards are rendered.
   */
  class SocialTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      if (start) {
        this.querySelector(".created-at")!.textContent = getYearsString(start);
      }
    }
  }

  // Prevent duplicate registration errors if the page transitions
  if (!customElements.get("social-tracker")) {
    customElements.define("social-tracker", SocialTracker);
  }
</script>

<style>
  /* ==========================================================
     SOCIAL CARD SPECIFIC STYLES
     ========================================================== */
  social-tracker {
    display: block;
  }

  .card-header {
    display: flex;
    padding: var(--spacing-md);
    gap: 12px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    background: var(--theme-surface-variant);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--theme-on-surface-variant);
  }

  .avatar svg {
    width: 28px;
    height: 28px;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
  }

  .name-row {
    display: flex;
    justify-content: space-between;
    color: var(--theme-on-surface);
    font-family: var(--font-headline);
  }

  .headline,
  .created-at {
    font-size: 12px;
    color: var(--theme-on-surface-variant);
  }

  .card-body p {
    margin: 0;
    padding: 0 var(--spacing-md) var(--spacing-md) var(--spacing-md);
    font-size: 14px;
    line-height: 1.5;
    color: var(--theme-on-surface);
  }

  .card-body img {
    width: 100%;
    display: block;
    border-top: 1px solid var(--theme-outline-variant);
  }

  .card-footer {
    padding: 12px var(--spacing-md);
    border-top: 1px solid var(--theme-outline-variant);
    background: var(--theme-surface-container);
  }

  /* ==========================================================
     PROJECT CARD SPECIFIC STYLES
     ========================================================== */
  .project-content {
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--spacing-sm);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }

  .project-desc {
    color: var(--theme-on-surface-variant);
    flex-grow: 1;
  }
</style>
