---
// src/components/Skills.astro
/**
 * @fileoverview Skills matrix component.
 * Automatically calculates years of experience at runtime.
 */
import { siteConfig } from "../data/config.ts";
import { getExperienceString } from "../utils/dateUtils.ts";

const { skills } = siteConfig;
---

<section id="skills" class="section">
  <div class="section-header">
    <span class="material-symbols-outlined icon-primary">terminal</span>
    <h2>Core Expertise</h2>
  </div>

  <div class="skill-list">
    {
      skills.map((skill) => {
        // Build-time calculation (Acts as the initial SEO-friendly state)
        const expString = getExperienceString(skill.startDate);

        return (
          <div
            class="card skill-card js-skill-item"
            data-start={skill.startDate}
          >
            <h3>{skill.name}</h3>
            <span class="js-skill-exp">{expString}</span>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  import { getExperienceString } from "../utils/dateUtils.ts";

  function hydrateSkills() {
    const items = document.querySelectorAll<HTMLElement>(".js-skill-item");

    items.forEach((item) => {
      const start = item.dataset.start;
      if (!start) return;

      // Find the specific span within this card
      const expEl = item.querySelector(".js-skill-exp");

      // Inject the newly calculated string based on the runtime clock
      if (expEl) {
        expEl.textContent = getExperienceString(start);
      }
    });
  }

  // Execute as soon as the DOM is ready
  document.addEventListener("DOMContentLoaded", hydrateSkills);
</script>

<style>
  .skill-list {
    display: grid;
    gap: var(--spacing-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .skill-card {
    padding: var(--spacing-md);
  }

  .skill-card h3 {
    font-size: 1.5rem;
    margin-bottom: 4px;
  }

  .skill-card span {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--theme-outline);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
