---
import { siteConfig } from "../data/config.ts";
import { getExperienceString } from "../utils/dateUtils.ts";

const { skills } = siteConfig;
---

<section id="skills" class="section">
  <div class="section-header">
    <span class="material-symbols-outlined icon-primary">terminal</span>
    <h2>Core Expertise</h2>
  </div>

  <div class="skill-list">
    {
      skills.map((skill) => {
        const expString = getExperienceString(skill.startDate);

        return (
          <skill-tracker class="card skill-card" data-start={skill.startDate}>
            <h3>{skill.name}</h3>
            <span class="skill-exp">{expString}</span>
          </skill-tracker>
        );
      })
    }
  </div>
</section>

<script>
  import { getExperienceString } from "../utils/dateUtils.ts";

  class SkillTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      if (start) {
        // Hydrate instantly upon mounting
        this.querySelector(".skill-exp")!.textContent =
          getExperienceString(start);
      }
    }
  }

  customElements.define("skill-tracker", SkillTracker);
</script>

<style>
  .skill-list {
    display: grid;
    gap: var(--spacing-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .skill-card {
    padding: var(--spacing-md);
  }

  .skill-card h3 {
    font-size: 1.5rem;
    margin-bottom: 4px;
  }

  .skill-card span {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--theme-outline);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
