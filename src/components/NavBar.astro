---
/**
 * @fileoverview Navigation Bar Component.
 * Handles routing across the site and dynamically adjusts for sub-pages.
 */
import { siteConfig } from "../data/config.ts";

export interface Props {
  // Default to true so you don't have to pass it on the index page
  isMainPage?: boolean;
}

const { isMainPage = true } = Astro.props;

// Destructure exactly what we need directly from the config
const { logo, nav, sections } = siteConfig;
---

<nav class="navbar">
  <div class="container navbar-content">
    <div class="logo">{logo}</div>

    <div class:list={["nav-links", { "main-page": isMainPage }]}>
      {
        isMainPage ? (
          Object.values(sections).map((sectionData) => {
            return (
              <a href={`#${sectionData.id}`} class="nav-link">
                {sectionData.id}
              </a>
            );
          })
        ) : (
          <a href="/" class="home-link">
            <span class="material-symbols-outlined" aria-hidden="true">
              keyboard_double_arrow_left
            </span>
            HOME
          </a>
        )
      }
    </div>

    {
      isMainPage && (
        <a
          href={nav.resumeUrl}
          class="btn btn-primary btn-sm"
          target="_blank"
          rel="noopener noreferrer"
        >
          Resume
        </a>
      )
    }
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    background: color-mix(in srgb, var(--theme-surface) 80%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--theme-outline-variant);
  }

  .navbar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }

  .logo {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  /* --- Navigation Links --- */
  .nav-links {
    display: none; /* Hidden by default on mobile */
    align-items: center;
    gap: var(--spacing-lg);
    font-family: var(--font-code);
    font-size: 0.875rem;
  }

  .nav-links a {
    color: var(--theme-on-surface-variant);
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--theme-primary);
  }

  .nav-links a.active {
    color: var(--theme-primary);
    font-weight: 700;
    border-bottom: 2px solid var(--theme-primary);
    vertical-align: bottom;
  }

  /* Specific styling for the 'HOME' back button */
  .home-link {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* --- Responsive Display Logic --- */

  /* 1. Always show the "HOME" back button, even on mobile */
  .nav-links:not(.main-page) {
    display: flex;
  }

  /* 2. Show the standard section links ONLY on desktop */
  @media (min-width: 768px) {
    .nav-links.main-page {
      display: flex;
    }
  }
</style>
