---
/**
 * @fileoverview Renders the featured projects grid using the common SectionLayout.
 */

import SectionLayout from "../layouts/SectionLayout.astro";
import "../styles/card.css";
import { siteConfig } from "../data/config";

const { projects } = siteConfig.sections;
---

<SectionLayout id={projects.id} icon="code_blocks" title="Featured Work">
  <div class="grid-4">
    {
      projects.items.map((project) => (
        <article class="card project-card">
          <div class="img-wrapper">
            <img
              src={project.imageUrl}
              alt={`Preview graphic for ${project.title}`}
              loading="lazy"
            />
          </div>

          <div class="project-content">
            <header class="project-header">
              <h3>{project.title}</h3>
              <a
                href={project.link}
                aria-label={`View external link for ${project.title}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="material-symbols-outlined" aria-hidden="true">
                  open_in_new
                </span>
              </a>
            </header>

            <p class="project-desc">{project.description}</p>

            <footer class="tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </footer>
          </div>
        </article>
      ))
    }
  </div>
</SectionLayout>

<style>
  .project-content {
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--spacing-sm);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
  }

  .project-desc {
    color: var(--theme-on-surface-variant);
    flex-grow: 1;
  }
</style>
