---
/**
 * @description Renders social media feed using the common SectionLayout and unified Card factory.
 */

import { siteConfig } from '../../data/config';
import SectionLayout from '../../layouts/SectionLayout.astro';
import { SocialCard } from '../ui/index.astro';

const { social } = siteConfig.sections;
---

<SectionLayout id={social.id} icon="share" title="Social Feed">
  <div class="grid grid-cols-4" data-columns="4">
    {social.items.map((post) => <SocialCard payload={post} />)}
  </div>
</SectionLayout>
