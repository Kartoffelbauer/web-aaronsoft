---
/**
 * @fileoverview Page `Hero` section. Displays the primary hero banner
 * including avatar, headline and primary call-to-action.
 */
import profilePic from '@/assets/img/profile.jpg';
import DevHero from '@/components/ui/DevHero.astro';
import { siteConfig } from '@/data/config';
import SectionLayout from '@/layouts/SectionLayout.astro';

const { hero } = siteConfig.sections;
---

<SectionLayout id={hero.id}>
  <DevHero
    title={hero.title}
    description={hero.description}
    image={profilePic}
    linkedinUrl={hero.linkedinUrl}
    githubUrl={hero.githubUrl}
  />
</SectionLayout>
