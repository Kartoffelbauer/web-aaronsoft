---
/**
 * @fileoverview Primary landing section (Hero).
 *
 * Best Practice implementation utilizing CSS Container Queries for true fluid
 * responsiveness, decoupling the layout from viewport media queries.
 * Keeps structural grid and h1 hierarchy independent from standard layouts.
 */

import { Image } from "astro:assets";
import { siteConfig } from "../../data/config.ts";
import profilePic from "../../assets/img/profile.jpg";
import Button from "../ui/Button.astro";

const { hero } = siteConfig.sections;
---

<section id={hero.id} class="hero-section">
  <div class="hero-content">
    <h1>{hero.title}</h1>
    <p>{hero.description}</p>

    <nav class="hero-actions" aria-label="Social Links">
      <Button href={hero.linkedinUrl} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined" aria-hidden="true">
          open_in_new
        </span>
        LinkedIn
      </Button>
      <Button
        href={hero.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
      >
        GitHub
      </Button>
    </nav>
  </div>

  <div class="hero-image-wrapper">
    <div class="image-border">
      <Image
        src={profilePic}
        alt="Portrait of the author"
        width={360}
        class="profile-img"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    /* 1. Container context for responsive child elements */
    container-type: inline-size;
    container-name: hero;

    /* 2. DRY: Use logical properties instead of individual top/bottom declarations */
    padding-block: var(--spacing-lg) var(--spacing-xl);

    display: grid;
    gap: var(--spacing-xl);

    /* 3. Fluid grid: dynamically creates columns based on available space */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    align-items: center;
  }

  .hero-content h1 {
    font-size: 3rem;
    line-height: 1.2;
    font-weight: 300;
    margin-bottom: var(--spacing-md);
  }

  .hero-content p {
    font-size: 1.125rem;
    color: var(--theme-on-surface-variant);
    margin-bottom: var(--spacing-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
  }

  .hero-image-wrapper {
    display: flex;
    /* Mobile-first: Default alignment when stacked in a single column */
    justify-content: center;
  }

  /**
   * CONTAINER QUERY ALIGNMENT FIX
   * * Trigger the alignment change precisely when the grid snaps to two columns.
   * Math: 400px (Col 1) + 400px (Col 2) + var(--spacing-xl) gap.
   * * Note: Assuming var(--spacing-xl) evaluates to 64px, the snap is at 864px.
   */
  @container hero (min-width: 864px) {
    .hero-image-wrapper {
      justify-content: flex-end;
    }
  }

  .image-border {
    padding: 8px;
    border: 1px solid var(--theme-outline-variant);
    border-radius: 16px;
    background: var(--theme-surface-container);
  }

  .profile-img {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }

  .profile-img:hover {
    filter: grayscale(0%);
  }
</style>
