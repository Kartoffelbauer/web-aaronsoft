---
/**
 * @fileoverview Page `Hero` section. Displays the primary hero banner
 * including avatar, headline and primary call-to-action.
 */
import { Image } from 'astro:assets';

import profilePic from '@/assets/img/profile.jpg';
import { Button } from '@/components/ui/index';
import { siteConfig } from '@/data/config';

const { hero } = siteConfig.sections;
---

<header
  id={hero.id}
  class="flex flex-col-reverse lg:flex-row items-center justify-between gap-lg py-md text-center lg:text-left"
>
  {/* Primary Content (Text & CTAs) */}
  <div class="flex-1">
    <h1 class="mb-md leading-tight">{hero.title}</h1>
    <p class="mb-lg text-lg text-surface-variant">{hero.description}</p>

    {/* Navigation/Actions: Centered on mobile, left-aligned on desktop */}
    <nav
      class="flex justify-center lg:justify-start gap-md"
      aria-label="Hero Actions"
    >
      <Button
        href={hero.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        icon="open_in_new"
        aria-label="View LinkedIn Profile"
      >
        LinkedIn
      </Button>

      <Button
        href={hero.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
        aria-label="View GitHub Profile"
      >
        GitHub
      </Button>
    </nav>
  </div>

  {/* Hero Image / Avatar Container */}
  <div
    class="shrink-0 border border-outline-variant rounded-md bg-surface-container p-sm max-w-md lg:justify-self-end"
  >
    <Image
      src={profilePic}
      alt="Developer profile picture"
      width={360}
      class="w-full aspect-square object-cover rounded-md grayscale transition-filter hover:grayscale-0"
      loading="eager"
    />
  </div>
</header>
