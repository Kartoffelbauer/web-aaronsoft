---
import profilePic from '@/assets/img/profile.jpg';
import UiHero from '@/components/ui/Hero.astro';
import { siteConfig } from '@/data/config';
import SectionLayout from '@/layouts/SectionLayout.astro';

const { hero } = siteConfig.sections;
---

<SectionLayout id={hero.id}>
  <UiHero
    title={hero.title}
    description={hero.description}
    image={profilePic}
    imageAlt="Portrait of the author"
    primaryAction={{
      label: 'LinkedIn',
      url: hero.linkedinUrl,
    }}
    secondaryAction={{
      label: 'GitHub',
      url: hero.githubUrl,
    }}
  />
</SectionLayout>
