---
/**
 * @description Renders the featured projects grid using the common SectionLayout and unified Card factory.
 */

import { ProjectCard } from '@/components/ui/index.astro';
import { siteConfig } from '@/data/config';
import SectionLayout from '@/layouts/SectionLayout.astro';

const { projects } = siteConfig.sections;
---

<SectionLayout id={projects.id} icon="code_blocks" title="Featured Work">
  <div class="grid grid-cols-4" data-columns="4">
    {projects.items.map((project) => <ProjectCard payload={project} />)}
  </div>
</SectionLayout>
