---
/**
 * @fileoverview Renders a grid of core skills utilizing the SectionLayout.
 */

import SectionLayout from "../../layouts/SectionLayout.astro";
import SkillCard from "../ui/SkillCard.astro";
import { siteConfig } from "../../data/config.ts";

const { skills } = siteConfig.sections;
---

<SectionLayout id={skills.id} icon="terminal" title="Core Expertise">
  <div class="skill-list grid-2">
    {
      skills.items.map((skill) => (
        <SkillCard payload={skill} />
      ))
    }
  </div>
</SectionLayout>
