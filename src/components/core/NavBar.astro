---
/**
 * @fileoverview Navigation Bar Component.
 * Handles routing across the site. Styling relies on global utility classes.
 */
import { siteConfig } from '@/data/config';

export interface Props {
  isMainPage?: boolean;
}

const { isMainPage = true } = Astro.props;
const { logo, nav, sections } = siteConfig;
---

<nav class="navbar">
  <div
    class="container flex items-center justify-between gap-md navbar-content"
  >
    <div class="logo">{logo}</div>

    <div
      class:list={[
        'items-center gap-lg font-code text-sm',
        isMainPage ? 'hidden md:flex' : 'flex',
      ]}
    >
      {
        isMainPage ? (
          Object.values(sections).map((sectionData) => (
            <a
              href={`#${sectionData.id}`}
              class="text-surface-variant hover:text-surface-variant hover:text-primary nav-link"
            >
              {sectionData.id}
            </a>
          ))
        ) : (
          <a
            href="/"
            class="flex items-center text-surface-variant hover:text-surface-variant hover:text-primary"
          >
            <span class="material-symbols-outlined icon" aria-hidden="true">
              keyboard_double_arrow_left
            </span>
            HOME
          </a>
        )
      }
    </div>

    {
      isMainPage && (
        <a
          href={nav.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          data-size="sm"
          data-variant="primary"
        >
          Resume
        </a>
      )
    }
  </div>
</nav>

<style>
  /* Scoped styles now ONLY handle the fixed, frosted-glass header effect and active state */
  .navbar {
    position: fixed;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--theme-outline-variant);
    background: color-mix(in srgb, var(--theme-surface) 80%, transparent);
    width: 100%;
  }

  .navbar-content {
    height: var(--shell-height-base);
  }

  .navbar-content a {
    text-decoration: none;
  }

  /* Specific component state overrides */
  .nav-link.active {
    border-bottom: 2px solid var(--theme-primary);
    color: var(--theme-primary);
  }
</style>
