---
/**
 * @fileoverview Navigation Bar Component.
 * Handles routing across the site. Styling relies on global utility classes.
 */
import { siteConfig } from '@/data/config';

export interface Props {
  isMainPage?: boolean;
}

const { isMainPage = true } = Astro.props;
const { logo, nav, sections } = siteConfig;
---

<nav
  class="fixed top-0 z-50 w-full border-b border-outline-variant glass-effect"
>
  <div class="container flex items-center justify-between gap-md h-shell">
    <a
      href="/"
      class="text-primary font-medium text-xl font-headline no-underline"
    >
      {logo}
    </a>

    <div
      class:list={[
        'items-center gap-lg font-code text-sm',
        isMainPage ? 'hidden md:flex' : 'flex',
      ]}
    >
      {
        isMainPage ? (
          Object.values(sections).map((sectionData) => (
            <a
              href={`#${sectionData.id}`}
              class="text-surface-variant hover:text-surface-variant hover:text-primary nav-link no-underline"
            >
              {sectionData.id}
            </a>
          ))
        ) : (
          <a
            href="/"
            class="flex items-center text-surface-variant hover:text-surface-variant hover:text-primary no-underline"
          >
            <span class="material-symbols-outlined" aria-hidden="true">
              keyboard_double_arrow_left
            </span>
            HOME
          </a>
        )
      }
    </div>

    {
      isMainPage && (
        <a
          href={nav.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
          data-size="sm"
          data-variant="primary"
        >
          Resume
        </a>
      )
    }
  </div>
</nav>

<style>
  .glass-effect {
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--theme-surface) 80%, transparent);
  }

  .nav-link.active {
    border-bottom: 2px solid var(--theme-primary);
    color: var(--theme-primary);
  }
</style>
