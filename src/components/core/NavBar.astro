---
/**
 * @fileoverview Navigation Bar Component.
 * Handles routing across the site. Styling relies on global utility classes.
 */
import { Button, Container, Logo } from '@/components/ui/index';
import { siteConfig } from '@/data/config';

export interface Props {
  isMainPage?: boolean;
}

const { isMainPage = true } = Astro.props;
const { logo, nav, sections } = siteConfig;
---

<nav class="sticky top-0 z-50 border-b border-outline-variant glass-effect">
  <Container class="flex items-center justify-between gap-md h-xl">
    <Logo title={logo} />

    <div
      class:list={[
        'items-center gap-lg font-code text-sm',
        isMainPage ? 'hidden md:flex' : 'flex',
      ]}
    >
      {
        isMainPage ? (
          Object.values(sections).map((sectionData) => (
            <Button
              href={`#${sectionData.id}`}
              variant="text"
              size="small"
              class="nav-link"
            >
              {sectionData.id}
            </Button>
          ))
        ) : (
          <Button
            href="/"
            variant="text"
            size="small"
            icon="keyboard_double_arrow_left"
            aria-label="Navigate to Home"
          >
            HOME
          </Button>
        )
      }
    </div>

    {
      isMainPage && (
        <Button
          href={nav.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          size="small"
          aria-label="View Resume"
        >
          Resume
        </Button>
      )
    }
  </Container>
</nav>

<style>
  .glass-effect {
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--theme-surface) 80%, transparent);
  }

  .nav-link.active {
    border-bottom: 2px solid var(--theme-primary);
    color: var(--theme-primary);
  }
</style>
