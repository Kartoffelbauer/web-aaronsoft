---
import { siteConfig } from "../../data/config.ts";
import { getCurrentYear } from "../../utils/dateUtils.ts";

const { logo } = siteConfig;
---

<footer class="footer">
  <div class="container footer-content">
    <div class="logo">{logo}</div>

    <div class="footer-copyright">
      &copy; <current-year>{getCurrentYear()}</current-year> Software Engineer Portfolio.
      Built with precision.
    </div>

    <div class="footer-links">
      <a href="/impress">Impressum</a>
      <a href="/privacy">Datenschutz</a>
    </div>
  </div>
</footer>

<script>
  import { getCurrentYear } from "../../utils/dateUtils.ts";

  class CurrentYear extends HTMLElement {
    connectedCallback() {
      this.textContent = getCurrentYear();
    }
  }

  customElements.define("current-year", CurrentYear);
</script>

<style>
  current-year {
    display: inline;
  }

  .footer {
    background: var(--theme-surface-container-lowest);
    border-top: 1px solid var(--theme-outline-variant);
  }

  .footer-content {
    display: flex;
    padding: 0 var(--spacing-lg);
    justify-content: center;
    gap: var(--spacing-sm);
    align-items: center;
    flex-direction: column;
    height: var(--shell-height-md);
  }

  @media (min-width: 950px) {
    .footer-content {
      justify-content: space-between;
      gap: var(--spacing-md);
      flex-direction: row;
      height: var(--shell-height-base);
    }
  }

  .footer-copyright {
    color: var(--theme-on-surface-variant);
  }

  .footer-links {
    display: flex;
    gap: var(--spacing-md);
    font-family: var(--font-code);
    font-size: var(--font-size-base);
  }

  .footer-links a {
    color: var(--theme-on-surface-variant);
  }

  .footer-links a:hover {
    color: var(--theme-primary);
  }
</style>
