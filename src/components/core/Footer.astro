---
/**
 * @fileoverview Global Footer Component.
 * Utilizes utility framework for responsive layout and typography.
 */
import { siteConfig } from '@/data/config';
import { getCurrentYear } from '@/utils/dateUtils';

const { logo } = siteConfig;
---

<footer class="footer">
  <div
    class="container flex flex-col items-center justify-center gap-sm lg:flex-row lg:justify-between lg:gap-md footer-content"
  >
    <div class="logo">{logo}</div>

    <div class="text-surface-variant">
      &copy; <current-year>{getCurrentYear()}</current-year> Software Engineer Portfolio.
      Built with precision.
    </div>

    <div class="flex gap-md font-code text-base">
      <a
        href="/impress"
        class="text-surface-variant hover:text-surface-variant hover:text-primary"
        >Impressum</a
      >
      <a
        href="/privacy"
        class="text-surface-variant hover:text-surface-variant hover:text-primary"
        >Datenschutz</a
      >
    </div>
  </div>
</footer>

<script>
  import { getCurrentYear } from '@/utils/dateUtils';

  class CurrentYear extends HTMLElement {
    connectedCallback() {
      this.textContent = getCurrentYear();
    }
  }

  customElements.define('current-year', CurrentYear);
</script>

<style>
  current-year {
    display: inline;
  }

  /* Scoped styles now ONLY handle unique structural dimensions and backgrounds */
  .footer {
    background: var(--theme-surface-container-lowest);
    border-top: 1px solid var(--theme-outline-variant);
  }

  .footer-content {
    height: var(--shell-height-md);
  }

  @media (min-width: 950px) {
    .footer-content {
      padding: 0 var(--spacing-lg);
      height: var(--shell-height-base);
    }
  }
</style>
