---
/**
 * @fileoverview Global Footer Component.
 * Utilizes mobile-first utility classes to strictly control stacking behavior.
 */

import { Logo } from '@/components/ui/index.astro';
import LinkButton from '@/components/ui/LinkButton.astro';
import { siteConfig } from '@/data/config';
import { getCurrentYear } from '@/utils/dateUtils';

const { logo } = siteConfig;
---

<footer class="border-t border-outline-variant bg-surface-lowest">
  <div
    class="container flex flex-col items-center justify-center gap-sm py-sm lg:flex-row md:justify-between"
  >
    <Logo title={logo} />

    <div class="text-surface-variant text-center">
      &copy; <current-year class="inline">{getCurrentYear()}</current-year> Software
      Engineer Portfolio. Built with precision.
    </div>

    <nav
      class="flex items-center justify-center gap-md font-code text-base"
      aria-label="Legal Navigation"
    >
      <LinkButton href="/impress" variant="link" aria-label="View Imprint">
        Impressum
      </LinkButton>

      <LinkButton
        href="/privacy"
        variant="link"
        aria-label="View Privacy Policy"
      >
        Datenschutz
      </LinkButton>
    </nav>
  </div>
</footer>

<script>
  import { getCurrentYear } from '@/utils/dateUtils';

  class CurrentYear extends HTMLElement {
    connectedCallback() {
      this.textContent = getCurrentYear();
    }
  }

  customElements.define('current-year', CurrentYear);
</script>
