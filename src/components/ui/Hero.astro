---
/**
 * @fileoverview Reusable Hero UI Component.
 * Purely presentational. Accepts strict props for content and actions.
 * Relies on a parent container (like SectionLayout) for global spacing.
 */

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  /** Astro's internal image object type for local assets */
  image: ImageMetadata;
  imageAlt?: string;
  primaryAction?: {
    label: string;
    url: string;
  };
  secondaryAction?: {
    label: string;
    url: string;
  };
}

const {
  title,
  description,
  image,
  imageAlt = 'Hero image',
  primaryAction,
  secondaryAction,
} = Astro.props;
---

<div class="hero-grid">
  <div class="hero-text">
    <h1 class="title">{title}</h1>
    <p class="description">{description}</p>

    {
      (primaryAction || secondaryAction) && (
        <nav class="hero-actions" aria-label="Primary Actions">
          {primaryAction && (
            <a
              href={primaryAction.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              data-variant="primary"
            >
              <span class="material-symbols-outlined icon" aria-hidden="true">
                open_in_new
              </span>
              {primaryAction.label}
            </a>
          )}

          {secondaryAction && (
            <a
              href={secondaryAction.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn"
              data-variant="outline"
            >
              {secondaryAction.label}
            </a>
          )}
        </nav>
      )
    }
  </div>

  <div class="hero-image-wrapper">
    <div class="image-border">
      <Image
        src={image}
        alt={imageAlt}
        width={360}
        class="profile-img"
        loading="eager"
      />
    </div>
  </div>
</div>

<style>
  /* ==========================================================
     1. FLUID GRID LAYOUT
     ========================================================== */
  .hero-grid {
    container-type: inline-size;
    container-name: hero;

    display: grid;
    gap: var(--spacing-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    align-items: center;
  }

  /* ==========================================================
     2. TYPOGRAPHY & ACTIONS
     ========================================================== */
  .title {
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
  }

  .description {
    font-size: var(--font-size-lg);
    color: var(--theme-on-surface-variant);
    margin-bottom: var(--spacing-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
  }

  /* ==========================================================
     3. IMAGE & CONTAINER QUERIES
     ========================================================== */
  .hero-image-wrapper {
    display: flex;
    justify-content: center; /* Mobile-first default */
  }

  @container hero (min-width: 864px) {
    .hero-image-wrapper {
      justify-content: flex-end;
    }
  }

  .image-border {
    padding: var(--spacing-sm);
    border: 1px solid var(--theme-outline-variant);
    border-radius: var(--border-radius-md);
    background: var(--theme-surface-container);

    & .profile-img {
      width: 100%;
      max-width: 360px;
      aspect-ratio: 1;
      object-fit: cover;
      border-radius: var(--border-radius-md);
      filter: grayscale(100%);
      transition: filter 0.5s ease;

      &:hover {
        filter: grayscale(0%);
      }
    }
  }
</style>
