---
/**
 * @fileoverview Renders a single technical skill card.
 * Uses atomic utilities exclusively, achieving zero localized CSS footprint.
 */

import { getExperienceString } from '@/utils/dateUtils';

import { Icon } from '../index.astro';
import BaseCard from './BaseCard.astro';

/**
 * Locally defined data structure for component independence.
 */
export interface SkillItem {
  name: string;
  startDate: string;
}

export interface Props {
  payload: SkillItem;
}

const { payload } = Astro.props;
---

<BaseCard as="skill-tracker" data-start={payload.startDate} class="p-md">
  <h3 class="flex items-center gap-sm text-lg font-medium mb-sm">
    <Icon name="code" class="" />
    {payload.name}
  </h3>
  <p class="text-outline text-sm font-code tracking-wider uppercase">
    {getExperienceString(payload.startDate)}
  </p>
</BaseCard>

<script>
  import { getExperienceString } from '@/utils/dateUtils';

  /**
   * Custom Element client-side hydration for dynamic experience strings.
   * Modulates rendering cleanly with scoped local DOM updates.
   */
  class SkillTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      if (!start) return;

      const expElement = this.querySelector('p');
      if (expElement) {
        expElement.textContent = getExperienceString(start);
      }
    }
  }

  if (!customElements.get('skill-tracker')) {
    customElements.define('skill-tracker', SkillTracker);
  }
</script>
