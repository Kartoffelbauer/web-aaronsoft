---
/**
 * @fileoverview Base container primitive for all card types.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';

export interface Props extends HTMLAttributes<'article'> {
  as?: HTMLTag;
}

const { as: Tag = 'article', class: className = '', ...rest } = Astro.props;
---

<Tag
  class:list={[
    'flex flex-col h-full overflow-hidden border border-outline-variant rounded-base bg-surface-container transition-colors hover:border-primary group',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
