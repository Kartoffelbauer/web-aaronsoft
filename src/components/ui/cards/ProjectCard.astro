---
/**
 * @fileoverview Renders a single project case study.
 * Refactored using utility-first layout principles and local typing encapsulation.
 */

import Button from '../Button.astro';
import BaseCard from './BaseCard.astro';

/**
 * Represents a portfolio project or case study.
 */
export interface ProjectItem {
  /** The display title of the project. */
  title: string;
  /** Absolute URL to the live project, repository, or case study. */
  linkUrl: string;
  /** A concise explanation of the project's purpose and architecture. */
  description: string;
  /** Absolute or relative URL to the project's thumbnail image. */
  imageUrl: string;
  /** An array of technologies or concepts utilized. @example ["React", "WebGL"] */
  tags: string[];
}

export interface Props {
  payload: ProjectItem;
}

const { payload } = Astro.props;
---

<BaseCard>
  <div class="h-fluid-sm shrink-0 overflow-hidden">
    <img
      src={payload.imageUrl}
      alt={`Preview graphic for ${payload.title}`}
      class="block w-full h-full object-cover transition-transform group-hover:scale-110"
      loading="lazy"
    />
  </div>

  <div class="flex flex-col grow p-md gap-sm">
    <header class="flex justify-between items-start">
      <h3>{payload.title}</h3>
      <Button
        href={payload.linkUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="text"
        icon="open_in_new"
        aria-label={`View ${payload.title}`}
        class="text-lg"
      />
    </header>

    <p class="text-surface-variant m-0">{payload.description}</p>

    <footer class="flex flex-wrap gap-sm mt-auto pt-sm">
      {
        payload.tags.map((tag) => (
          <span class="bg-primary-alpha-10 text-primary p-sm rounded-md text-sm font-code">
            {tag}
          </span>
        ))
      }
    </footer>
  </div>
</BaseCard>
