---
/**
 * @fileoverview Renders a single social media feed post.
 * Uses polymorphic component rendering and strictly utility-based styling.
 */

import { getYearsString } from '@/utils/dateUtils';

import LinkButton from '../Button.astro';
import Icon from '../Icon.astro';
import BaseCard from './BaseCard.astro';

/**
 * Encapsulated data structure defining a Social Item.
 */
export interface SocialItem {
  author: string;
  headline: string;
  startDate: string;
  linkUrl: string;
  content: string;
  imageUrl: string;
  tags: string[];
}

export interface Props {
  payload: SocialItem;
}

const { payload } = Astro.props;
---

<BaseCard as="social-tracker" data-start={payload.startDate}>
  <header class="flex gap-md p-md">
    <div class="grid place-items-center text-surface-variant">
      <Icon name="account_circle" class="text-xl" />
    </div>

    <div class="flex flex-col justify-center flex-1">
      <div class="flex justify-between text-on-surface font-headline">
        <strong>{payload.author}</strong>
      </div>
      <span class="text-surface-variant text-sm">{payload.headline}</span>
      <span class="text-surface-variant text-sm">
        {getYearsString(payload.startDate)}
      </span>
    </div>

    <LinkButton
      href={payload.linkUrl}
      target="_blank"
      rel="noopener noreferrer"
      variant="text"
      icon="open_in_new"
      aria-label={`View external link to post by ${payload.author}`}
      align="start"
      class="text-lg"
    />
  </header>

  <div class="flex flex-col grow">
    <p class="m-0 px-md pb-md text-on-surface text-base leading-normal">
      {payload.content}
    </p>

    <div class="mt-auto h-fluid-sm shrink-0 overflow-hidden">
      <img
        src={payload.imageUrl}
        alt="Post media graphic"
        class="block w-full h-full object-cover transition-transform group-hover:scale-110"
        loading="lazy"
      />
    </div>
  </div>

  <footer class="flex flex-wrap gap-sm p-md bg-surface-container">
    {
      payload.tags.map((tag) => (
        <span class="bg-primary-alpha-10 text-primary p-sm rounded-md text-sm font-code">
          {tag}
        </span>
      ))
    }
  </footer>
</BaseCard>

<script>
  import { getYearsString } from '@/utils/dateUtils';

  class SocialTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      if (start) {
        const timeElement = this.querySelector('.created-at');
        if (timeElement) {
          timeElement.textContent = getYearsString(start);
        }
      }
    }
  }

  if (!customElements.get('social-tracker')) {
    customElements.define('social-tracker', SocialTracker);
  }
</script>
