---
/**
 * @fileoverview Renders a single social media feed post.
 * Uses polymorphic component rendering to act as the web component itself.
 */

import type { SocialItem } from '@/types/index';
import { getYearsString } from '@/utils/dateUtils';

import BaseCard from './BaseCard.astro';

export interface Props {
  payload: SocialItem;
}

const { payload } = Astro.props;
---

<BaseCard as="social-tracker" data-start={payload.startDate}>
  <header class="card-header card-padding">
    <div class="avatar-wrapper">
      <span class="material-symbols-outlined" aria-hidden="true">
        account_circle
      </span>
    </div>

    <div class="user-info">
      <div class="name-row">
        <strong>{payload.author}</strong>
      </div>
      <span class="headline">{payload.headline}</span>
      <span class="created-at">{getYearsString(payload.startDate)}</span>
    </div>

    <a
      href={payload.linkUrl}
      aria-label={`View external link to post by ${payload.author}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="material-symbols-outlined" aria-hidden="true"
        >open_in_new</span
      >
    </a>
  </header>

  <div class="card-content">
    <p class="social-text">{payload.content}</p>

    <div class="card-img-wrapper social-img-fix">
      <img src={payload.imageUrl} alt="Post media graphic" loading="lazy" />
    </div>
  </div>

  <footer class="card-footer card-tags card-padding">
    {payload.tags.map((tag) => <span class="card-tag">{tag}</span>)}
  </footer>
</BaseCard>

<script>
  import { getYearsString } from '@/utils/dateUtils';

  class SocialTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      if (start) {
        const timeElement = this.querySelector('.created-at');
        if (timeElement) {
          timeElement.textContent = getYearsString(start);
        }
      }
    }
  }

  if (!customElements.get('social-tracker')) {
    customElements.define('social-tracker', SocialTracker);
  }
</script>

<style>
  .card-header {
    display: flex;
    gap: var(--spacing-md);
  }

  .avatar-wrapper {
    display: grid;
    place-items: center;
    color: var(--theme-on-surface-variant);
  }

  /* Properly targets the icon span */
  .avatar-wrapper span {
    font-size: var(--font-size-xl);
  }

  .user-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: center;
  }

  .name-row {
    display: flex;
    justify-content: space-between;
    color: var(--theme-on-surface);
    font-family: var(--font-headline);
  }

  .headline,
  .created-at {
    font-size: var(--font-size-sm);
    color: var(--theme-on-surface-variant);
  }

  .social-text {
    margin: 0;
    padding: 0 var(--spacing-md) var(--spacing-md) var(--spacing-md);
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--theme-on-surface);
  }

  .social-img-fix {
    margin-top: auto;
  }

  .card-footer {
    background: var(--theme-surface-container);
  }
</style>
