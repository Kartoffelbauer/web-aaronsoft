---
/**
 * @fileoverview Individual Education Timeline Item
 * Generates a timeline entry with server-side initial status evaluation,
 * followed by strict client-side hydration via a custom web component.
 */

import { getAcademicStatus } from '@/utils/dateUtils';

/**
 * Interface duplicated locally to maintain strict component independence.
 */
export interface EducationItem {
  startDate: string;
  endDate: string;
  degree: string;
  institution: string;
  description: string;
}

export interface Props {
  item: EducationItem;
}

const { item } = Astro.props;
const { durationText, statusLabel, isActive } = getAcademicStatus(
  item.startDate,
  item.endDate
);
---

<edu-tracker
  class="relative block pl-lg"
  data-start={item.startDate}
  data-end={item.endDate}
>
  <div
    class:list={[
      'timeline-dot absolute left-0 flex items-center justify-center rounded-full',
      isActive ? 'active' : 'inactive',
    ]}
  >
  </div>

  <div class="timeline-content">
    <header class="flex justify-between items-start mb-sm gap-sm">
      <h3>{item.degree}</h3>
      <span
        class:list={[
          'timeline-badge rounded-base p-sm text-sm font-code',
          isActive ? 'badge-active' : 'bg-surface-variant text-outline',
        ]}
      >
        {statusLabel}
      </span>
    </header>

    <p class="text-surface-variant font-medium m-0">{item.institution}</p>
    <p class="timeline-date-text text-outline text-sm font-code m-0">
      {durationText}
    </p>
    <p class="text-surface-variant mt-sm max-w-md m-0">{item.description}</p>
  </div>
</edu-tracker>

<script>
  import { getAcademicStatus } from '@/utils/dateUtils';

  /**
   * EducationTracker Web Component
   * Safely re-evaluates and hydrates the user's local date/time state
   * on the client, updating the DOM efficiently using clean private methods.
   */
  class EducationTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      const end = this.dataset.end;

      if (!start || !end) return;

      const { durationText, statusLabel, isActive } = getAcademicStatus(
        start,
        end
      );

      this.#updateTimelineDot(isActive);
      this.#updateBadge(statusLabel, isActive);
      this.#updateDateText(durationText);
    }

    #updateTimelineDot(isActive: boolean) {
      const dot = this.querySelector('.timeline-dot');
      if (!dot) return;

      dot.classList.toggle('active', isActive);
      dot.classList.toggle('inactive', !isActive);
    }

    #updateBadge(statusLabel: string, isActive: boolean) {
      const badge = this.querySelector('.timeline-badge');
      if (!badge) return;

      badge.textContent = statusLabel;

      if (isActive) {
        badge.classList.add('badge-active');
        badge.classList.remove('bg-surface-variant', 'text-outline');
      } else {
        badge.classList.remove('badge-active');
        badge.classList.add('bg-surface-variant', 'text-outline');
      }
    }

    #updateDateText(durationText: string) {
      const dateEl = this.querySelector('.timeline-date-text');
      if (dateEl) dateEl.textContent = durationText;
    }
  }

  // Prevent duplicate registrations during Hot Module Replacement (HMR)
  if (!customElements.get('edu-tracker')) {
    customElements.define('edu-tracker', EducationTracker);
  }
</script>

<style>
  .timeline-dot {
    top: 8px;
    border: 4px solid var(--theme-background);
    width: 24px;
    height: 24px;
  }

  .timeline-dot::after {
    border-radius: 50%;
    background: var(--theme-background);
    width: 6px;
    height: 6px;
    content: '';
  }

  .timeline-dot.active {
    background: var(--theme-primary);
  }

  .timeline-dot.inactive {
    background: var(--theme-outline);
  }

  .badge-active {
    background: color-mix(in srgb, var(--theme-primary) 10%, transparent);
    color: var(--theme-primary);
  }
</style>
