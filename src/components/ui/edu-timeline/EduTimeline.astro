---
/**
 * @fileoverview Education Timeline Container
 * Renders a vertical timeline layout using utility classes.
 * Delegates individual item rendering and hydration logic to EduTimelineItem.
 */

import type { EducationItem } from './EduTimelineItem.astro';
import EduTimelineItem from './EduTimelineItem.astro';

export interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
---

<div class="relative flex flex-col gap-lg">
  <div class="timeline-connector absolute"></div>

  {items.map((item) => <EduTimelineItem item={item} />)}
</div>

<style>
  .timeline-connector {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 11px;
    background: color-mix(
      in srgb,
      var(--theme-outline-variant) 30%,
      transparent
    );
    width: 2px;
  }
</style>
