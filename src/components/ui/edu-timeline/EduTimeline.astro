---
/**
 * @fileoverview Education Timeline Container
 * Renders a vertical timeline layout using utility classes.
 * Delegates individual item rendering and hydration logic to EduTimelineItem.
 */

import EduTimelineItem from './EduTimelineItem.astro';

/**
 * Locally defined data structure for the timeline.
 * Ensures component isolation and avoids cross-file generic imports (anti-pattern).
 */
export interface EducationItem {
  startDate: string;
  endDate: string;
  degree: string;
  institution: string;
  description: string;
}

export interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
---

<div class="relative flex flex-col gap-lg">
  <div class="timeline-connector"></div>

  {items.map((item) => <EduTimelineItem item={item} />)}
</div>

<style>
  .timeline-connector {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 11px;
    background: color-mix(
      in srgb,
      var(--theme-outline-variant) 30%,
      transparent
    );
    width: 2px;
  }
</style>
