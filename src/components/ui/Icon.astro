---
/**
 * @fileoverview Reusable Material Icon Component.
 * Provides a simple interface to render Material Icons by name.
 */
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {
  /** The name of the material icon. */
  name: string;
  /** Optional utility classes to override base sizing, color, or margins. */
  class?: string;
}

const { name, class: customClass = '', ...rest } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center justify-center shrink-0 leading-none',
    customClass,
  ]}
  {...rest}
>
  <span class="material-symbols-outlined" aria-hidden="true">
    {name}
  </span>
</span>

<style is:global>
  :where(.material-symbols-outlined) {
    font-style: normal;
    font-weight: normal;
    font-size: 1.25em;
    line-height: 1;
    font-family: 'Material Symbols Outlined';
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -moz-font-feature-settings: 'liga';
    -moz-osx-font-smoothing: grayscale;
  }
</style>
