---
/**
 * @file Icon.astro
 * @description A reusable, accessible wrapper for Google Material Symbols.
 * Uses strict visual modes to maintain design system consistency.
 */

import type { HTMLAttributes } from "astro/types";

/**
 * Component properties.
 * Inherits all standard HTML attributes for a `<span>` element
 * (e.g., `id`, `aria-label`, `data-*`, `style`, `class`).
 */
interface Props extends HTMLAttributes<"span"> {
  /**
   * The exact ligature name of the Material Symbol.
   * @example "home", "settings", "arrow_forward"
   * @see https://fonts.google.com/icons
   */
  name: string;

  /**
   * The predefined visual style variant of the icon.
   * - `primary`: Enforces a strict 2rem size and theme-primary color.
   * - `inherit`: Inherits the font-size and color of its parent container.
   * @default "primary"
   */
  mode?: "primary" | "inherit";
}

const { name, mode = "primary", class: className, ...rest } = Astro.props;
---

<span
  class:list={["material-symbols-outlined", `icon-${mode}`, className]}
  aria-hidden="true"
  {...rest}
>
  {name}
</span>

<style>
  /* Scoped styles for the icon variants.
    Update the CSS variables to match your global theme values.
  */
  .icon-primary {
    color: var(--theme-primary, #2563eb);
    font-size: 2rem;
  }

  /* Allows the icon to seamlessly blend into surrounding text contexts
    (e.g., inside buttons, headings, or standard paragraphs).
  */
  .icon-inherit {
    color: inherit;
    font-size: inherit;
  }
</style>
