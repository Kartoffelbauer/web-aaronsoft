---
/**
 * @fileoverview Reusable Material Icon Component.
 * Provides a simple interface to render Material Icons by name.
 */
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {
  /** The name of the material icon. */
  name: string;
  /** Optional utility classes to override or extend the default logo styling. */
  class?: string;
}

const { name, class: customClass = '', ...rest } = Astro.props;
---

<span
  class:list={['material-symbols-outlined', customClass]}
  aria-hidden="true"
  {...rest}
>
  {name}
</span>

<style>
  .material-symbols-outlined {
    display: inline-block;
    font-style: normal;
    font-weight: normal;
    line-height: 1;
    font-family: 'Material Symbols Outlined';
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -moz-font-feature-settings: 'liga';
    -moz-osx-font-smoothing: grayscale;
  }
</style>
