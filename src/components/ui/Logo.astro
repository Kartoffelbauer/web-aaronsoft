---
import Button from './Button.astro';

/**
 * @fileoverview Reusable Logo UI Component.
 * Serves as the primary brand text/link across the site (e.g., in NavBar/Footer).
 * Relies entirely on global utility classes for consistent branding.
 */

export interface Props {
  /** The text to display as the logo (e.g., developer's name or brand name). */
  title: string;
  /** Optional utility classes to override or extend the default logo styling. */
  class?: string;
}

const { title, class: customClass = '' } = Astro.props;
---

<Button
  href="/"
  variant="text-primary"
  class:list={['font-medium font-headline text-xl', customClass]}
  aria-label="Homepage"
>
  {title}
</Button>
