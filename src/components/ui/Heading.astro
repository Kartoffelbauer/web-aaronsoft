---
/**
 * @file Heading.astro
 * @description A polymorphic heading primitive.
 * Enforces global typography variables while allowing developers to decouple
 * semantic HTML structure (for SEO/a11y) from visual appearance.
 */

import type { HTMLAttributes } from "astro/types";

// Restrict the tags to valid HTML headings
type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

/**
 * Component properties.
 * Inherits all standard HTML attributes for a heading element
 * (e.g., `id`, `class`, `aria-label`).
 */
export interface Props extends Omit<HTMLAttributes<"h1">, "slot"> {
  /**
   * The semantic HTML tag to render in the DOM.
   * Crucial for accessibility (a11y) and SEO document outlines.
   * @default "h2"
   * @example "h1", "h3"
   */
  as?: HeadingTag;

  /**
   * Overrides the visual size of the heading.
   * If omitted, the heading will visually match its semantic tag.
   * @example "h1" (Makes an h3 visually look like an h1)
   */
  size?: HeadingTag;
}

const { as: Tag = "h2", size, class: className, ...rest } = Astro.props;

// If a specific visual size is requested, apply it.
// Otherwise, default to the size of the semantic tag.
const visualSizeClass = size ? `heading-${size}` : `heading-${Tag}`;
---

<Tag class:list={["heading-base", visualSizeClass, className]} {...rest}>
  <slot />
</Tag>

<style>
  /* 1. Base styles applied to ALL headings.
    This replaces your global h1...h6 CSS block.
  */
  .heading-base {
    font-family: var(--font-headline);
    font-weight: 500;
    color: var(--theme-on-surface);
    margin: 0;
    line-height: 1.6;
  }

  /* 2. Visual Size Variants.
    Update these sizes to match your specific typography scale.
  */
  .heading-h1 {
    font-size: 2.5rem;
  }
  .heading-h2 {
    font-size: 2rem;
  }
  .heading-h3 {
    font-size: 1.5rem;
  }
  .heading-h4 {
    font-size: 1.25rem;
  }
  .heading-h5 {
    font-size: 1.125rem;
  }
  .heading-h6 {
    font-size: 1rem;
  }
</style>
