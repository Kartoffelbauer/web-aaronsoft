---
/**
 * @fileoverview Container component for the academic timeline.
 * Handles the mapping of data items and the structural connecting line between them.
 */

import type { EducationItem } from '@/types/index.ts';

import EduTimelineItem from './EduTimelineItem.astro';

export interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
---

<div class="timeline">
  {items.map((item) => <EduTimelineItem item={item} />)}
</div>

<style>
  .timeline {
    display: flex;
    position: relative;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  /* The vertical connecting line */
  .timeline::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 11px;
    background: color-mix(
      in srgb,
      var(--theme-outline-variant) 30%,
      transparent
    );
    width: 2px;
    content: '';
  }
</style>
