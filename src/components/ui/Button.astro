---
/**
 * @fileoverview Polymorphic Button Component.
 */

import type { HTMLAttributes } from 'astro/types';

import Icon from './Icon.astro';

// 1. Strict Configuration Types
type Variant = 'primary' | 'outline' | 'text' | 'text-primary' | 'link';
type Size = 'base' | 'small';
type Align = 'center' | 'start' | 'end' | 'between';

// 2. Polymorphic Interface
export interface Props extends HTMLAttributes<'a'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  align?: Align;
  icon?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'base',
  align = 'center',
  icon,
  class: customClass = '',
  ...rest
} = Astro.props;

// 3. Utility Maps
const baseClasses =
  'inline-flex justify-center transition-all cursor-pointer font-code shrink-0';

const alignMap: Record<Align, string> = {
  center: 'items-center',
  start: 'items-start',
  end: 'items-end',
  between: 'items-center',
};

const variantMap: Record<Variant, string> = {
  primary:
    'bg-primary text-on-primary hover:text-on-primary focus-visible:text-on-primary visited:text-on-primary hover:opacity-90 font-medium no-underline',
  outline:
    'border border-outline text-on-surface hover:border-primary hover:text-primary focus-visible:border-primary font-medium no-underline',
  text: 'text-surface-variant hover:text-primary focus-visible:text-primary visited:text-surface-variant no-underline',
  'text-primary':
    'text-primary hover:opacity-90 focus-visible:opacity-90 visited:text-primary no-underline font-medium',
  link: 'text-surface-variant hover:text-primary focus-visible:text-primary visited:text-surface-variant',
};

// 4. Structure & Typography Isolation
const isPlain = variant.startsWith('text') || variant === 'link';

const structureMap: Record<Size, string> = {
  base: isPlain ? 'gap-sm' : 'px-lg py-md rounded-base gap-md',
  small: isPlain ? 'gap-xs' : 'px-md py-sm rounded-base gap-sm',
};

const typographyMap: Record<Size, string> = {
  base: 'text-base',
  small: 'text-sm',
};
---

<a
  {href}
  class:list={[
    baseClasses,
    alignMap[align],
    structureMap[size],
    typographyMap[size],
    variantMap[variant],
    customClass,
  ]}
  {...rest}
>
  {icon && <Icon name={icon} aria-hidden="true" class="shrink-0" />}
  <slot />
</a>
