---
/**
 * @fileoverview Polymorphic Button Component.
 * Dynamically renders `<a>` or `<button>` based on the presence of an `href`.
 * Follows strict utility-first architecture, DRY principles, and isolated state maps.
 */

import type { HTMLAttributes } from 'astro/types';

import Icon from './Icon.astro';

// 1. Strict Configuration Types
type Variant = 'primary' | 'outline' | 'text' | 'link';
type Size = 'base' | 'small';
type Align = 'center' | 'start' | 'end' | 'between';

// 2. Polymorphic Interface
// Omitting 'type' from anchor to prevent TS collisions, allowing strict button types
export interface Props extends Omit<
  HTMLAttributes<'a'> & HTMLAttributes<'button'>,
  'type'
> {
  href?: string;
  variant?: Variant;
  size?: Size;
  align?: Align;
  icon?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'base',
  align = 'center',
  icon,
  type,
  class: customClass = '',
  ...rest
} = Astro.props;

// 3. Dynamic Semantic Resolution
const Tag = href ? 'a' : 'button';
const buttonType = !href ? type || 'button' : undefined;

// 4. Utility Maps
const baseClasses =
  'inline-flex transition-all cursor-pointer font-code disabled-state shrink-0';

const alignMap: Record<Align, string> = {
  center: 'justify-center items-center',
  start: 'justify-start items-start',
  end: 'justify-end items-end',
  between: 'justify-between items-center',
};

// Explicit border declarations ensure layout doesn't shift when switching variants
const variantMap: Record<Variant, string> = {
  primary:
    'bg-primary border border-transparent text-on-primary hover:text-on-primary focus-visible:text-on-primary visited:text-on-primary hover:opacity-90 font-medium no-underline',
  outline:
    'bg-transparent border border-outline text-on-surface hover:border-primary hover:text-primary focus-visible:border-primary font-medium no-underline',
  text: 'bg-transparent border border-transparent text-surface-variant hover:text-primary focus-visible:text-primary visited:text-surface-variant no-underline',
  link: 'bg-transparent border border-transparent text-surface-variant hover:text-primary focus-visible:text-primary visited:text-surface-variant',
};

// 5. Structure & Typography Isolation
const isPlain = variant === 'text' || variant === 'link';

const structureMap: Record<Size, string> = {
  base: isPlain ? 'gap-sm' : 'px-lg py-md rounded-base gap-md',
  small: isPlain ? 'gap-xs' : 'px-md py-sm rounded-base gap-sm',
};

const typographyMap: Record<Size, string> = {
  base: 'text-base',
  small: 'text-sm',
};
---

<Tag
  {href}
  type={buttonType}
  class:list={[
    baseClasses,
    alignMap[align],
    structureMap[size],
    typographyMap[size],
    variantMap[variant],
    customClass,
  ]}
  {...rest}
>
  {icon && <Icon name={icon} aria-hidden="true" class="shrink-0" />}
  <slot />
</Tag>
