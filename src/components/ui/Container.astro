---
/**
 * @fileoverview Reusable Container primitive.
 * Enforces global max-width and fluid horizontal padding purely via utility classes.
 */
import type { HTMLAttributes } from 'astro/types';

type SemanticTag = 'div' | 'main' | 'section' | 'article' | 'header' | 'footer';

export interface Props extends HTMLAttributes<'div'> {
  as?: SemanticTag;
  class?: string;
}

const { as: Tag = 'div', class: customClass = '', ...rest } = Astro.props;
---

<Tag
  class:list={['w-full max-w-lg mx-auto px-md lg:px-lg', customClass]}
  {...rest}
>
  <slot />
</Tag>
