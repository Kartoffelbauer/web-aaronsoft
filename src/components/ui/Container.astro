---
/**
 * @file Container.astro
 * @description A layout primitive for standardizing maximum width, centering, and fluid padding.
 * Prevents content from stretching infinitely on ultra-wide displays.
 */

import type { HTMLAttributes } from "astro/types";

/**
 * Component properties.
 * Inherits standard HTML attributes (e.g., `id`, `aria-label`, `class`).
 */
export interface Props extends HTMLAttributes<"div"> {
  /**
   * Defines the structural role and styling of the container.
   * - `default`: Renders a standard `<div>` with responsive horizontal padding.
   * - `main`: Renders a semantic `<main>` tag and adds significant top padding,
   * ideal for wrapping a page's primary content.
   * * @default "default"
   */
  mode?: "default" | "main";
}

const { mode = "default", class: className, ...rest } = Astro.props;

// Dynamically resolve the HTML element based on the selected mode
const Tag = mode === "main" ? "main" : "div";
---

<Tag class:list={["container", `container-${mode}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    /* Fluid horizontal padding: 16px (mobile) scales to 32px (desktop) */
    padding-left: clamp(var(--spacing-md, 1rem), 4vw, var(--spacing-lg, 2rem));
    padding-right: clamp(var(--spacing-md, 1rem), 4vw, var(--spacing-lg, 2rem));
  }

  /* Main Mode Variant */
  .container-main {
    /* Adds substantial top padding to distance page content from the navigation/header */
    padding-top: calc(var(--spacing-xl) + var(--spacing-lg));
  }
</style>
