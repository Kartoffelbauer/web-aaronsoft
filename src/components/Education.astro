---
import { siteConfig } from "../data/config.ts";
import { getAcademicStatus } from "../utils/dateUtils.ts";

const { education } = siteConfig;
---

<section id="education" class="section">
  <div class="section-header">
    <span class="material-symbols-outlined icon-primary">school</span>
    <h2>Academic Journey</h2>
  </div>

  <div class="timeline">
    {
      education.map((item) => {
        // Build-time calculation (Acts as the initial SEO-friendly state)
        const { durationText, statusLabel, isActive } = getAcademicStatus(
          item.startDate,
          item.endDate,
        );

        return (
          <div
            class="timeline-item js-edu-item"
            data-start={item.startDate}
            data-end={item.endDate}
          >
            <div
              class:list={[
                "timeline-dot js-edu-dot",
                isActive ? "active" : "inactive",
              ]}
            />

            <div class="timeline-content">
              <div class="timeline-header">
                <h3>{item.degree}</h3>
                <span
                  class:list={[
                    "timeline-badge js-edu-badge",
                    isActive ? "badge-active" : "badge-inactive",
                  ]}
                >
                  {statusLabel}
                </span>
              </div>

              <p class="timeline-inst">{item.institution}</p>
              <p class="timeline-date js-edu-duration">{durationText}</p>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<script>
  import { getAcademicStatus } from "../utils/dateUtils.ts";

  function hydrateAcademicTimelines() {
    const items = document.querySelectorAll<HTMLElement>(".js-edu-item");

    items.forEach((item) => {
      const start = item.dataset.start;
      const end = item.dataset.end;

      if (!start || !end) return;

      // Recalculate using the client's current runtime clock
      const { durationText, statusLabel, isActive } = getAcademicStatus(
        start,
        end,
      );

      // DOM Elements
      const dot = item.querySelector(".js-edu-dot");
      const badge = item.querySelector(".js-edu-badge");
      const durationEl = item.querySelector(".js-edu-duration");

      // Inject runtime state
      if (dot)
        dot.className = `timeline-dot js-edu-dot ${isActive ? "active" : "inactive"}`;
      if (badge) {
        badge.className = `timeline-badge js-edu-badge ${isActive ? "badge-active" : "badge-inactive"}`;
        badge.textContent = statusLabel;
      }
      if (durationEl) durationEl.textContent = durationText;
    });
  }

  // Execute as soon as the DOM is ready
  document.addEventListener("DOMContentLoaded", hydrateAcademicTimelines);
</script>

<style>
  /* * 'display: contents' tells the browser to treat the <academic-tracker> wrapper
   * as if it doesn't exist for layout purposes, preventing it from breaking your Flexbox/Grid CSS!
   */
  academic-tracker {
    display: contents;
  }

  /* --- Original Timeline CSS --- */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(194, 198, 214, 0.3);
  }

  .timeline-item {
    position: relative;
    padding-left: 40px;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 4px solid var(--theme-background);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-dot::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--theme-background);
  }

  .timeline-dot.active {
    background: var(--theme-primary);
  }

  .timeline-dot.inactive {
    background: var(--theme-outline);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 4px;
  }

  .timeline-badge {
    font-family: var(--font-code);
    font-size: 0.875rem;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .badge-active {
    color: var(--theme-primary);
    background: rgba(0, 90, 194, 0.1);
  }

  .badge-inactive {
    color: var(--theme-outline);
    background: var(--theme-surface-variant);
  }

  .timeline-inst {
    font-weight: 600;
    color: var(--theme-on-surface-variant);
  }

  .timeline-date {
    font-family: var(--font-code);
    font-size: 0.875rem;
    color: var(--theme-outline);
  }

  .timeline-desc {
    color: var(--theme-on-surface-variant);
    margin-top: 8px;
    max-width: 600px;
  }
</style>
