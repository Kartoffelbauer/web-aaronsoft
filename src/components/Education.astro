---
import { siteConfig } from "../data/config.ts";
import { getAcademicStatus } from "../utils/dateUtils.ts";

const { education } = siteConfig.sections;
---

<section id={education.displayName} class="section">
  <div class="section-header">
    <span class="material-symbols-outlined icon-primary">school</span>
    <h2>Academic Journey</h2>
  </div>

  <div class="timeline">
    {
      education.items.map((item) => {
        const { durationText, statusLabel, isActive } = getAcademicStatus(
          item.startDate,
          item.endDate,
        );

        return (
          <academic-tracker
            class="timeline-item"
            data-start={item.startDate}
            data-end={item.endDate}
          >
            <div
              class:list={["timeline-dot", isActive ? "active" : "inactive"]}
            />

            <div class="timeline-content">
              <div class="timeline-header">
                <h3>{item.degree}</h3>
                <span
                  class:list={[
                    "timeline-badge",
                    isActive ? "badge-active" : "badge-inactive",
                  ]}
                >
                  {statusLabel}
                </span>
              </div>

              <p class="timeline-inst">{item.institution}</p>
              <p class="timeline-date">{durationText}</p>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </academic-tracker>
        );
      })
    }
  </div>
</section>

<script>
  import { getAcademicStatus } from "../utils/dateUtils.ts";

  // 2. Define the Custom Element behavior
  class AcademicTracker extends HTMLElement {
    connectedCallback() {
      const start = this.dataset.start;
      const end = this.dataset.end;

      if (!start || !end) return;

      const { durationText, statusLabel, isActive } = getAcademicStatus(
        start,
        end,
      );

      // 3. Scoped DOM updates (no document.querySelector needed)
      this.querySelector(".timeline-dot")!.className =
        `timeline-dot ${isActive ? "active" : "inactive"}`;

      const badge = this.querySelector(".timeline-badge")!;
      badge.className = `timeline-badge ${isActive ? "badge-active" : "badge-inactive"}`;
      badge.textContent = statusLabel;

      this.querySelector(".timeline-date")!.textContent = durationText;
    }
  }

  // 4. Register the component with the browser
  customElements.define("academic-tracker", AcademicTracker);
</script>

<style>
  /* Ensure the custom element behaves like a block container */
  academic-tracker {
    display: block;
  }

  /* --- Original Timeline CSS --- */
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(194, 198, 214, 0.3);
  }

  .timeline-item {
    position: relative;
    padding-left: 40px;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 4px solid var(--theme-background);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-dot::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--theme-background);
  }

  .timeline-dot.active {
    background: var(--theme-primary);
  }

  .timeline-dot.inactive {
    background: var(--theme-outline);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 4px;
  }

  .timeline-badge {
    font-family: var(--font-code);
    font-size: 0.875rem;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .badge-active {
    color: var(--theme-primary);
    background: rgba(0, 90, 194, 0.1);
  }

  .badge-inactive {
    color: var(--theme-outline);
    background: var(--theme-surface-variant);
  }

  .timeline-inst {
    font-weight: 600;
    color: var(--theme-on-surface-variant);
  }

  .timeline-date {
    font-family: var(--font-code);
    font-size: 0.875rem;
    color: var(--theme-outline);
  }

  .timeline-desc {
    color: var(--theme-on-surface-variant);
    margin-top: 8px;
    max-width: 600px;
  }
</style>
