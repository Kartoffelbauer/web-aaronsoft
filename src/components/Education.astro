---
/**
 * @fileoverview Academic timeline component.
 * Automatically calculates semesters and graduation dates.
 */
import { siteConfig } from "../data/config.ts";
import { formatAcademicDuration } from "../utils/dateUtils.ts";

const { education } = siteConfig;
---

<section id="education" class="section">
  <div class="section-header">
    <span class="material-symbols-outlined icon-primary">school</span>
    <h2>Academic Journey</h2>
  </div>

  <div class="timeline">
    {
      education.map((item) => {
        // Compute dynamic strings at build time
        const durationString = formatAcademicDuration(item);
        const statusLabel = item.isActive ? "Current" : "Completed";

        return (
          <div class="timeline-item">
            <div
              class:list={[
                "timeline-dot",
                item.isActive ? "active" : "inactive",
              ]}
            />

            <div class="timeline-content">
              <div class="timeline-header">
                <h3>{item.degree}</h3>
                <span
                  class:list={[
                    "timeline-badge",
                    item.isActive ? "badge-active" : "badge-inactive",
                  ]}
                >
                  {statusLabel}
                </span>
              </div>

              <p class="timeline-inst">{item.institution}</p>
              <p class="timeline-date">{durationString}</p>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(194, 198, 214, 0.3);
  }

  .timeline-item {
    position: relative;
    padding-left: 40px;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 4px solid var(--theme-background);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-dot::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--theme-background);
  }

  .timeline-dot.active {
    background: var(--theme-primary);
  }

  .timeline-dot.inactive {
    background: var(--theme-outline);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 4px;
  }

  .timeline-badge {
    font-family: var(--font-code);
    font-size: 0.875rem;
    padding: 4px 8px;
    border-radius: 4px;
  }

  .badge-active {
    color: var(--theme-primary);
    background: rgba(0, 90, 194, 0.1);
  }

  .badge-inactive {
    color: var(--theme-outline);
    background: var(--theme-surface-variant);
  }

  .timeline-inst {
    font-weight: 600;
    color: var(--theme-on-surface-variant);
  }

  .timeline-date {
    font-family: var(--font-code);
    font-size: 0.875rem;
    color: var(--theme-outline);
  }

  .timeline-desc {
    color: var(--theme-on-surface-variant);
    margin-top: 8px;
    max-width: 600px;
  }
</style>
