---
/**
 * @file Hero.astro
 * @description Primary landing section. Kept independent from SectionLayout
 * as its structural grid and h1 hierarchy differ from standard page sections.
 */

import { Image } from "astro:assets";
import { siteConfig } from "../data/config.ts";
import profilePic from "../assets/img/profile.jpg";

const { hero } = siteConfig.sections;
---

<section id={hero.id} class="hero-section">
  <div class="hero-content">
    <h1>{hero.title}</h1>
    <p>{hero.description}</p>

    <nav class="hero-actions" aria-label="Social Links">
      <a href={hero.linkedinUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
        LinkedIn
      </a>
      <a href={hero.githubUrl} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    </nav>
  </div>

  <div class="hero-image-wrapper">
    <div class="image-border">
      <Image
        src={profilePic}
        alt="Portrait picture of the author"
        width={360}
        class="profile-img"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-xl);
    display: grid;
    gap: var(--spacing-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    align-items: center;
  }

  .hero-content h1 {
    font-size: 3rem;
    line-height: 1.2;
    font-weight: 300;
    margin-bottom: var(--spacing-md);
  }

  .hero-content p {
    font-size: 1.125rem;
    color: var(--theme-on-surface-variant);
    margin-bottom: var(--spacing-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
  }

  .hero-image-wrapper {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-image-wrapper {
      justify-content: flex-end;
    }
  }

  .image-border {
    padding: 8px;
    border: 1px solid var(--theme-outline-variant);
    border-radius: 16px;
    background: var(--theme-surface-container);
  }

  .profile-img {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }

  .profile-img:hover {
    filter: grayscale(0%);
  }
</style>
