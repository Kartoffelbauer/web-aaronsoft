---
import { siteConfig } from '../data/config.ts';
const { hero } = siteConfig;
---

<section id="about" class="hero-section">
  <div class="hero-content">
    <h1>{hero.title}</h1>
    <p>{hero.description}</p>
    <div class="hero-actions">
      <a href={hero.linkedin} class="btn btn-primary" target="_blank">
        <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span> LinkedIn
      </a>
      <a href={hero.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
    </div>
  </div>

  <div class="hero-image-wrapper">
    <div class="image-border">
      <img src={hero.image} alt="Profile picture" class="profile-img" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero-section {
    margin-top: var(--spacing-xl);
    padding: calc(var(--spacing-xl)) 0 var(--spacing-lg) 0;
    display: grid;
    gap: var(--spacing-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    align-items: center;
  }

  .hero-content h1 {
    font-size: 3rem;
    line-height: 1.2;
    font-weight: 300;
    margin-bottom: var(--spacing-md);
  }

  .hero-content p {
    font-size: 1.125rem;
    color: var(--theme-on-surface-variant);
    margin-bottom: var(--spacing-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
  }

  .hero-image-wrapper {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-image-wrapper { justify-content: flex-end; }
  }

  .image-border {
    padding: 8px;
    border: 1px solid var(--theme-outline-variant);
    border-radius: 16px;
    background: var(--theme-surface-container);
  }

  .profile-img {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    filter: grayscale(100%);
    transition: filter 0.5s ease;
  }

  .profile-img:hover {
    filter: grayscale(0%);
  }
</style>