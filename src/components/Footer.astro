---
/**
 * @fileoverview Global footer component.
 * Features client-side hydration to ensure the copyright year is never out of date.
 */
import { siteConfig } from "../data/config.ts";
import { getCurrentYear } from "../utils/dateUtils.ts";

const { logo, githubUrl, linkedinUrl } = siteConfig;
---

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-logo">{logo}</div>

    <div class="footer-copyright">
      &copy; <span class="js-current-year">{getCurrentYear()}</span> Software Engineer
      Portfolio. Built with precision.
    </div>

    <div class="footer-links">
      <a href="/impress">Impressum</a>
      <a href="/privacy">Datenschutz</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer"
        >LinkedIn</a
      >
    </div>
  </div>
</footer>

<script>
  import { getCurrentYear } from "../utils/dateUtils.ts";

  function hydrateCopyrightYear() {
    const yearEl = document.querySelector(".js-current-year");
    if (yearEl) {
      yearEl.textContent = getCurrentYear();
    }
  }

  // Execute as soon as the DOM is ready
  document.addEventListener("DOMContentLoaded", hydrateCopyrightYear);
</script>

<style>
  .footer {
    background: var(--theme-surface-container-lowest);
    border-top: 1px solid var(--theme-outline-variant);
    padding: var(--spacing-md) 0;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    align-items: center;
  }

  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-logo {
    color: var(--theme-primary);
    font-weight: 600;
    font-family: var(--font-headline);
    font-size: 1.5rem;
  }

  .footer-copyright {
    color: var(--theme-on-surface-variant);
  }

  .footer-links {
    display: flex;
    gap: var(--spacing-md);
    font-family: var(--font-code);
    font-size: 0.875rem;
  }

  .footer-links a {
    color: var(--theme-on-surface-variant);
    text-decoration: underline;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--theme-primary);
  }
</style>
