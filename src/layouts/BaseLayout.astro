---
import "../styles/reset.css";
import "../styles/typography.css";
import "../styles/theme.css";

// Define the expected shape of your props (TypeScript Best Practice)
export interface Props {
  title: string;
  description: string;
}

// Extract the variables from the global Astro.props object
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />

    <script>
      import { initScrollSpy } from "../utils/scrollSpy";

      // Wrap the call in an arrow function to drop the Event object
      // and explicitly pass our 128px navbar offset.
      document.addEventListener("DOMContentLoaded", () => {
        initScrollSpy(128);
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--spacing-xl);
  }

  body {
    /* Layout offsets */
    padding-top: calc(var(--spacing-xl) + var(--spacing-lg));

    /* Theme application */
    background-color: var(--theme-background);
    color: var(--theme-on-background);
    font-family: var(--font-body);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-headline);
    font-weight: 500;
    color: var(--theme-on-surface);
  }
</style>
