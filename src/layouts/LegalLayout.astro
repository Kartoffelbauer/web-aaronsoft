---
/**
 * @fileoverview Base layout for legal pages.
 * Handles the standard page shell (Nav, Footer) and provides
 * encapsulated typographic defaults for slotted legal text.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/core/NavBar.astro";
import Footer from "../components/core/Footer.astro";

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <NavBar isMainPage={false} />

  <main class="container legal-content">
    <slot />
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal-content {
    :global(p) {
      margin-bottom: var(--spacing-md);
    }

    /* Group anchor styles and utilize nesting for states */
    :global(a) {
      color: var(--theme-link);
      text-decoration: underline;
      /* Added best-practice transition for smoother UX */
      transition: color 0.2s ease;

      &:visited {
        color: var(--theme-link-visited);
      }

      /* Group hover and focus-visible for accessibility */
      &:hover,
      &:focus-visible {
        color: var(--theme-link-hover);
      }
    }
  }
</style>
