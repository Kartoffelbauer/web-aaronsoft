---
/**
 * @fileoverview Reusable layout wrapper for page sections.
 * Enforces DRY structure and consistent spacing using strictly utility classes.
 */

interface Props {
  id: string;
  icon?: string;
  title?: string;
  class?: string;
}

const { id, icon, title, class: className = '' } = Astro.props;
---

<section
  {id}
  class:list={[
    'pt-md border-t border-divider first-of-type:border-none first-of-type:mb-md',
    className,
  ]}
>
  {
    title && (
      <header class="flex items-center gap-sm mb-lg">
        {icon && (
          <span
            class="material-symbols-outlined text-primary"
            aria-hidden="true"
          >
            {icon}
          </span>
        )}
        <h2 class="text-xl font-headline font-medium">{title}</h2>
      </header>
    )
  }

  <slot />
</section>
