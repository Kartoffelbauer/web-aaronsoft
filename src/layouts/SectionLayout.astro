---
/**
 * @fileoverview A reusable layout wrapper for standard page sections. Enforces DRY structure
 * for section headers, icons, and consistent spacing across the application.
 */

import { Icon, Heading } from "../components/ui/index.astro";

interface Props {
  id: string;
  icon: string;
  title: string;
  class?: string;
}

const { id, icon, title, class: className = "" } = Astro.props;
---

<section id={id} class:list={["section", { className }]}>
  <header class="section-header">
    <Icon name={icon} />
    <Heading as="h2">{title}</Heading>
  </header>

  <slot />
</section>

<style>
  .section {
    padding: var(--spacing-md) 0 var(--spacing-lg) 0;
    border-top: 1px solid
      color-mix(in srgb, var(--theme-outline-variant) 30%, transparent);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
  }
</style>
