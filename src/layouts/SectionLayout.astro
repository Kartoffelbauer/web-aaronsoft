---
/**
 * @fileoverview Reusable layout wrapper for page sections.
 * Enforces DRY structure and consistent spacing.
 */

interface Props {
  id: string;
  icon?: string;
  title?: string;
  class?: string;
}

const { id, icon, title, class: className = "" } = Astro.props;
---

<section id={id} class:list={["section", className]}>
  {
    title && (
      <header class="flex items-center gap-sm mb-lg">
        {icon && (
          <span
            class:list={["material-symbols-outlined icon", className]}
            aria-hidden="true"
            data-variant="primary"
          >
            {icon}
          </span>
        )}
        <h2 class="h2">{title}</h2>
      </header>
    )
  }

  <slot />
</section>

<style>
  /* Scoped styling strictly handles component-specific margins and borders */
  .section {
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--theme-divider);
  }

  /* Remove border for the very first section (Hero) */
  .section:first-of-type {
    margin-bottom: var(--spacing-md);
    border-top: none;
  }
</style>
