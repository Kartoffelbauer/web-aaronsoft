---
import Icon from '@/components/ui/Icon.astro';

/**
 * @fileoverview Reusable layout wrapper for page sections.
 * Enforces DRY structure and consistent spacing using strictly utility classes.
 */

interface Props {
  id: string;
  icon: string;
  title: string;
  class?: string;
}

const { id, icon, title, class: className = '' } = Astro.props;
---

<section {id} class:list={['pt-md border-t border-divider', className]}>
  {
    title && (
      <header class="flex items-center gap-sm mb-lg">
        {icon && <Icon name={icon} class="text-primary" />}
        <h2 class="font-headline font-medium">{title}</h2>
      </header>
    )
  }

  <slot />
</section>
