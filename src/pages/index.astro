---
/**
 * @fileoverview Main entry point mapping to the root '/' URL.
 * Assembles the layout and section components cleanly.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/core/NavBar.astro';
import Hero from '../components/sections/Hero.astro';
import Education from '../components/sections/Education.astro';
import Skills from '../components/sections/Skills.astro';
import Projects from '../components/sections/Projects.astro';
import Footer from '../components/core/Footer.astro';
import Socials from '../components/sections/Socials.astro';
import { siteConfig } from '../data/config';

const { hero } = siteConfig.sections;
---

<BaseLayout
  title={`${hero.title} | ${siteConfig.logo}`}
  description={hero.description}
>
  <NavBar />

  <!-- Flex column with gap-xl provides uniform spacing between all major sections automatically -->
  <main class="container flex flex-col gap-lg">
    <Hero />
    <Education />
    <Skills />
    <Projects />
    <Socials />
  </main>

  <Footer />
</BaseLayout>
