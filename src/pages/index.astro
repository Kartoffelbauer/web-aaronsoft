---
/**
 * @fileoverview Main entry point mapping to the root '/' URL.
 * Assembles the layout and section components cleanly.
 */

import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Hero from "../components/sections/Hero.astro";
import Education from "../components/sections/Education.astro";
import Skills from "../components/sections/Skills.astro";
import Projects from "../components/sections/Projects.astro";
import Footer from "../components/Footer.astro";
import Socials from "../components/sections/Socials.astro";

import { siteConfig } from "../data/config.ts";
const { hero } = siteConfig.sections;
---

<BaseLayout
  title=`${hero.title} | ${siteConfig.logo}`
  description={hero.description}
>
  <NavBar />
  <main class="container">
    <Hero />
    <Education />
    <Skills />
    <Projects />
    <Socials />
  </main>
  <Footer />
</BaseLayout>
