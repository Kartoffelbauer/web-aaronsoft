---
/**
 * @fileoverview Impress mapping to '/impress' URL.
 * Assembles the layout and section components cleanly.
 */

import LegalLayout from "../layouts/LegalLayout.astro";
import { Container } from "../components/ui/index.astro";
import { siteConfig } from "../data/config.ts";

const { personalData } = siteConfig.legal;
---

<LegalLayout
  title=`Impressum | ${siteConfig.logo}`
  description=`Impressum von ${siteConfig.logo}`
>
  <Container class="legal-content">
    <h1 class="h1">Impressum</h1>

    <p>
      {personalData.name}<br />
      {personalData.address.street}<br />
      {personalData.address.zip}
      {personalData.address.city}<br />
      {personalData.address.country}
    </p>

    <h2 class="h2">Kontakt</h2>
    <p>
      Telefon: <a href={`tel:${personalData.phone}`}>{personalData.phone}</a><br
      />
      E-Mail: <a href={`mailto:${personalData.email}`}>{personalData.email}</a>
    </p>

    <p>Quelle: <a href="https://www.e-recht24.de">eRecht24</a></p>
  </Container>
</LegalLayout>
